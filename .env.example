# ======================================================================
# REQUIRED: LLM Provider (choose one)
# ======================================================================
OPENROUTER_API_KEY=
# -- or --
ANTHROPIC_API_KEY=
# -- or --
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: override default model (default: openai/gpt-5.4-nano)
LLM_MODEL=

# ======================================================================
# REQUIRED: Messaging Platform (choose at least one)
# ======================================================================

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=          # comma-separated user IDs
TELEGRAM_ALLOW_ALL_USERS=        # true to skip allowlist
TELEGRAM_HOME_CHANNEL=
TELEGRAM_HOME_CHANNEL_NAME=

# Discord
DISCORD_BOT_TOKEN=
DISCORD_ALLOWED_USERS=           # comma-separated user IDs
DISCORD_ALLOW_ALL_USERS=         # true to skip allowlist
DISCORD_HOME_CHANNEL=
DISCORD_HOME_CHANNEL_NAME=
DISCORD_REQUIRE_MENTION=
DISCORD_FREE_RESPONSE_CHANNELS=

# Slack (requires both tokens)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
SLACK_ALLOWED_USERS=             # comma-separated user IDs
SLACK_ALLOW_ALL_USERS=           # true to skip allowlist
SLACK_HOME_CHANNEL=
SLACK_HOME_CHANNEL_NAME=
# Shared-channel gating (upstream Hermes; uncomment as needed)
# SLACK_ALLOWED_CHANNELS=        # comma-separated channel IDs the bot may respond in
# SLACK_STRICT_MENTION=true      # require a fresh @mention for every channel message
# SLACK_IGNORE_OTHER_USER_MENTIONS=true  # skip messages addressed to another user
# SLACK_ALLOW_BOTS=mentions      # none | mentions | all
# SLACK_REQUIRE_MENTION=true     # top-level channel messages need an @mention (Hermes default)
# SLACK_REACTION_TRIGGERS=true   # reactions on the bot's own messages become agent turns
# Slack experience (written to config.yaml on boot; unset = off; see README "Slack experience")
# SLACK_STREAMING=true           # live-typing replies via Slack native streaming
# SLACK_RICH_BLOCKS=true         # Block Kit replies (lists, tables, headers)
# SLACK_FEEDBACK_BUTTONS=true    # thumbs up/down under replies; needs SLACK_RICH_BLOCKS
# SLACK_NATIVE_TASK_CARDS=true   # tool calls as live Slack task cards
# SLACK_SUGGESTED_PROMPTS=default  # or JSON [{"title":..,"message":..}], max 4
# SLACK_LIVE_STATUS=verb         # full | verb | off
# SLACK_RUNTIME_FOOTER=on        # on | off | model,context_pct,latency,served_model,cwd
# SLACK_CHANNEL_PROMPTS=         # JSON {"C0123456789":"prompt"}
# SLACK_CHANNEL_SKILL_BINDINGS=  # JSON [{"id":"C0123456789","skills":["x402-payments"]}]

# ======================================================================
# Radius Wallet (optional)
# ======================================================================
RADIUS_PRIVATE_KEY=              # leave unset: exported from radius-cli's keystore on first boot (you can't supply your own)
RADIUS_WALLET_ADDRESS=           # leave unset: derived from radius-cli's keystore on first boot
RADIUS_NETWORK=                  # defaults to Radius Testnet
RADIUS_AUTO_FUND=                # on by default (first boot only); set to false to skip the faucet

# ======================================================================
# Linear (optional)
# ======================================================================
LINEAR_API_KEY=              # Personal API key from Linear Settings → API → Personal API keys
LINEAR_TEAM_ID=              # Default team ID to scope issue operations (optional)
LINEAR_PROJECT_ID=           # Specific project ID to interact with (optional)

# ======================================================================
# Persistent Storage (optional)
# ======================================================================

BYTEROVER_API_KEY=           # Cloud sync mode — set to use ByteRover cloud account
BYTEROVER_LOCAL=             # true to use ByteRover in local-only mode (no API key needed)




# ======================================================================
# Tool Integrations (optional)
# ======================================================================
FIRECRAWL_API_KEY=
GITHUB_TOKEN=
FAL_KEY=
ELEVENLABS_API_KEY=
VOICE_TOOLS_OPENAI_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
BROWSERBASE_PROXIES=
BROWSERBASE_ADVANCED_STEALTH=
NOUS_API_KEY=
TINKER_API_KEY=
WANDB_API_KEY=
RL_API_URL=

# ======================================================================
# Terminal Backend (optional)
# ======================================================================
TERMINAL_BACKEND=                # local, docker, singularity, modal, ssh
TERMINAL_CWD=
TERMINAL_TIMEOUT=
TERMINAL_LIFETIME_SECONDS=
TERMINAL_DOCKER_IMAGE=
TERMINAL_SINGULARITY_IMAGE=
TERMINAL_MODAL_IMAGE=
TERMINAL_CONTAINER_CPU=
TERMINAL_CONTAINER_MEMORY=
TERMINAL_CONTAINER_DISK=
TERMINAL_CONTAINER_PERSISTENT=
TERMINAL_SANDBOX_DIR=
TERMINAL_SSH_HOST=
TERMINAL_SSH_USER=
TERMINAL_SSH_PORT=
TERMINAL_SSH_KEY=
SUDO_PASSWORD=

# ======================================================================
# Hermes Tuning (optional)
# ======================================================================
HERMES_INFERENCE_PROVIDER=
HERMES_PORTAL_BASE_URL=
NOUS_INFERENCE_BASE_URL=
HERMES_NOUS_MIN_KEY_TTL_SECONDS=
HERMES_MAX_ITERATIONS=
HERMES_TOOL_PROGRESS=
HERMES_TOOL_PROGRESS_MODE=
HERMES_DUMP_REQUESTS=
CONTEXT_COMPRESSION_ENABLED=
CONTEXT_COMPRESSION_THRESHOLD=
CONTEXT_COMPRESSION_MODEL=

# ======================================================================
# Shared workspace hardening (optional; re-applied to config.yaml on every boot)
# ======================================================================
HERMES_DISABLED_TOOLSETS=        # e.g. terminal,file,code_execution,delegation,cronjob; "none" re-enables all. Deleting the var leaves the last value in config.yaml
HERMES_BACKGROUND_REVIEW=        # false to stop the automatic post-turn memory/skill review
HERMES_MEMORY_NOTIFICATIONS=     # off | on | verbose ("💾 Memory updated" lines in chat)

# ======================================================================
# Gateway (optional)
# ======================================================================
GATEWAY_ALLOW_ALL_USERS=         # true to allow all users across all platforms
WHATSAPP_ENABLED=
WHATSAPP_ALLOWED_USERS=

# ======================================================================
# Agent Identity (optional)
# ======================================================================
AGENT_DESCRIPTION=       # One-line description published in /.well-known/agent-card.json

# ======================================================================
# Webhook / A2A Bridge (optional)
# ======================================================================
# Enable Hermes webhook server so POST /a2a can forward tasks to it.
WEBHOOK_ENABLED=         # true to enable
WEBHOOK_PORT=            # default: 8644
WEBHOOK_SECRET=          # Required for A2A bridge — HMAC key for Hermes webhook auth

# ======================================================================
# JWT authentication
# ======================================================================
# API key used to exchange for a JWT via POST /token with X-Api-Key header.
# Leave unset to disable token issuance endpoint.
# JWT signing reuses RADIUS_PRIVATE_KEY (secp256k1, shared with the wallet).
JWT_API_KEY=
# Comma-separated DID allowlist for inbound A2A JWT auth.
# Only these peers and local tokens issued by POST /token can call gated endpoints.
# Unset or empty denies all external DIDs; discovery remains public.
# Example: TRUSTED_DIDS=did:web:peer.example.com
TRUSTED_DIDS=

# ======================================================================
# Debug (optional)
# ======================================================================
WEB_TOOLS_DEBUG=
VISION_TOOLS_DEBUG=
MOA_TOOLS_DEBUG=
IMAGE_TOOLS_DEBUG=

# x402 dogfood controls (Radius Testnet only; no requests unless hosts are listed)
X402_ALLOWED_HOSTS=              # exact trusted seller hostnames, e.g. grug402.dev
X402_MAX_PER_CALL=               # default 0.01 SBC; positive, finite, at most six decimals
X402_DEMO_BASE_URL=              # optional catalog origin; must pass the same host checks
X402_LEDGER_PATH=                # default ${HERMES_HOME}/x402/ledger.jsonl

# Paid A2A (Radius Testnet SBC). Authenticated callers stay free; paid fallback bypasses DID/KYA, even required modes.
# Public paid callers use the full configured Hermes backend. Use a dedicated deployment with restricted tools/plugins.
# Payment settles before execution; later failures have no automatic refund. See README.md: Paid A2A.
A2A_X402_ENABLED=                # true to admit public paid POST /a2a callers; off by default
A2A_PRICE_SBC=                   # default 0.001 SBC per request; at most 1, six decimals
A2A_X402_FACILITATOR_URL=        # default https://facilitator.testnet.radiustech.xyz

# Optional KYA signed claims. Does not certify regulatory compliance or settlement.
# Modes: did_only (default), did_and_kya, did_or_kya, kya_only.
A2A_AUTH_MODE=did_only
KYA_INBOUND_POLICY=off
# Required before KYA authentication can succeed; HTTPS issuer URLs or wildcard subdomains.
TRUSTED_KYA_ISSUERS=
KYA_EXPECTED_AUDIENCE=
KYA_EXPECTED_ENVIRONMENT=
